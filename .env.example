# MEDGUARD Healthcare Trust Gateway Environment Configuration

# Backend Server Configuration
PORT=3001
NODE_ENV=development

# Database Configuration
# Default is embedded SQLite database at server/medguard.db
DATABASE_PATH=server/medguard.db

# Blockchain Node RPC (Simulated consortium network)
CONSORTIUM_NODES_COUNT=5
BLOCK_CONFIRMATIONS_REQUIRED=5
MERKLE_BATCH_INTERVAL_MS=300000

# Client Configuration
VITE_API_URL=http://127.0.0.1:3001
